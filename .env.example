# Supabase project (Project Settings -> API). The service role key bypasses RLS,
# so it stays on the server and is never handed to a client.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Force the in-memory demo dataset even when Supabase vars are present.
# BACKEND=memory

POLICY_PATH=policy.yaml

# Recorded as the requester on every proposal. Must differ from APPROVER_IDENTITY,
# or the self-approval check will reject the commit.
AGENT_IDENTITY=mcp-agent

# The human end of the loop.
APPROVER_IDENTITY=you@example.com
APPROVER_PORT=7337
APPROVER_BASE_URL=http://localhost:7337

# --- Approver authentication ---------------------------------------------
# dev   trusts APPROVER_IDENTITY below. Local only; refuses to start when
#       NODE_ENV=production.
# proxy identity comes from a header set by an identity-aware proxy
#       (oauth2-proxy, Cloudflare Access, ALB+OIDC). Requires the shared
#       secret, or anyone reaching the app directly could set the header.
# link  per-approval signed links, minted with:
#         npm run approver -- link <approval_id> <subject>
APPROVER_AUTH=dev

# proxy mode
APPROVER_HEADER=x-forwarded-email
APPROVER_PROXY_SECRET=

# link mode
APPROVER_TOKEN_SECRET=
APPROVER_LINK_TTL_SECONDS=900
